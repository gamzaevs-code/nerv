# Neon / PostgreSQL
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-your-endpoint.c-4.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Auth
JWT_SECRET="nerv-development-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="nerv-development-secret"

# OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Rate limit (optional Upstash)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional email: SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_PASS=""
SMTP_FROM="НЕРВ <no-reply@nerv.local>"
SMTP_SECURE="false"

# Optional email: Resend
RESEND_API_KEY=""
RESEND_FROM="НЕРВ <no-reply@nerv.local>"

# Optional integrations
STRIPE_SECRET_KEY=""
TELEGRAM_BOT_TOKEN=""
VIDEO_PROVIDER=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
